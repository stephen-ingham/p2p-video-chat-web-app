# syntax=docker/dockerfile:1

# Stage 1: Build the Astro SSR React.js Application
FROM dhi.io/node:26-alpine-dev AS base
# Mirrors the repo layout so the Tailwind colours plugin finds the shared
# colors.json at ../../colors.json, as it does outside Docker.
WORKDIR /voneo/web-server/src

COPY package.json package-lock.json ./

FROM base AS prod-deps
RUN npm install --omit=dev

FROM base AS build-deps
RUN npm install

FROM build-deps AS build
COPY . .
# Shared palette from the repo root, via the `root` build context.
COPY --from=root colors.json /voneo/colors.json
RUN npm run build

# Stage 2: Run the Astro SSR React.js app
FROM base AS runtime
COPY --from=prod-deps /voneo/web-server/src/node_modules ./node_modules
COPY --from=build /voneo/web-server/src/dist ./dist

ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["node", "./dist/server/entry.mjs"]


