{
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024", "dom", "dom.iterable"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"types": ["astro/client", "@testing-library/jest-dom/vitest"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": "..",
		"paths": {
			"@/*": ["./src/src/*"],
			"@testing-library/react": ["./src/node_modules/@testing-library/react"]
		}
	},
	"include": ["**/*", "../src/src/env.d.ts"]
}
