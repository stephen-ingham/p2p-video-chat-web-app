{
  "resources": [
    {
      "type": "docker-build:index:Image",
      "name": "backend-image",
      "inputs": {
        "buildOnPreview": true,
        "context": {
          "location": "../web-socket-api/src"
        },
        "dockerfile": {
          "location": "../web-socket-api/src/Dockerfile.prod"
        },
        "exec": true,
        "network": "default",
        "platforms": [
          "linux/amd64"
        ],
        "push": true,
        "registries": [
          {
            "address": "europe-west2-docker.pkg.dev",
            "username": "oauth2accesstoken"
          }
        ],
        "tags": [
          "europe-west2-docker.pkg.dev/snapshot-test-project/voneo-snapshot-test/voneo-backend:snapshot-test"
        ]
      }
    },
    {
      "type": "docker-build:index:Image",
      "name": "frontend-image",
      "inputs": {
        "buildOnPreview": true,
        "context": {
          "location": "../web-server/src",
          "named": {
            "root": {
              "location": ".root-context"
            }
          }
        },
        "dockerfile": {
          "location": "../web-server/src/Dockerfile.prod"
        },
        "exec": true,
        "network": "default",
        "platforms": [
          "linux/amd64"
        ],
        "push": true,
        "registries": [
          {
            "address": "europe-west2-docker.pkg.dev",
            "username": "oauth2accesstoken"
          }
        ],
        "tags": [
          "europe-west2-docker.pkg.dev/snapshot-test-project/voneo-snapshot-test/voneo-frontend:snapshot-test"
        ]
      }
    },
    {
      "type": "gcp:artifactregistry/repository:Repository",
      "name": "images",
      "inputs": {
        "cleanupPolicies": [
          {
            "action": "DELETE",
            "condition": {
              "olderThan": "604800s",
              "tagState": "UNTAGGED"
            },
            "id": "delete-untagged"
          },
          {
            "action": "KEEP",
            "id": "keep-recent",
            "mostRecentVersions": {
              "keepCount": 3
            }
          }
        ],
        "cleanupPolicyDryRun": false,
        "format": "DOCKER",
        "location": "europe-west2",
        "repositoryId": "voneo-snapshot-test"
      }
    },
    {
      "type": "gcp:cloudrunv2/service:Service",
      "name": "backend",
      "inputs": {
        "deletionProtection": false,
        "ingress": "INGRESS_TRAFFIC_ALL",
        "invokerIamDisabled": false,
        "labels": {
          "git-dirty": "false",
          "git-sha": "snapshot-test-sha"
        },
        "location": "europe-west2",
        "name": "voneo-backend-snapshot-test",
        "scaling": {
          "maxInstanceCount": 1,
          "minInstanceCount": 0
        },
        "template": {
          "containers": [
            {
              "envs": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "ALLOWED_ORIGIN",
                  "value": "https://voneo-frontend-snapshot-test-123456789.europe-west2.run.app"
                },
                {
                  "name": "DB_NAME",
                  "value": "voneo"
                },
                {
                  "name": "DB_USER",
                  "value": "voneo"
                },
                {
                  "name": "DB_HOST",
                  "value": "/cloudsql/undefined"
                },
                {
                  "name": "DB_PASSWORD",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "db-password-snapshot-test",
                      "version": "latest"
                    }
                  }
                },
                {
                  "name": "JWT_SECRET",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "jwt-secret-snapshot-test",
                      "version": "latest"
                    }
                  }
                },
                {
                  "name": "REFRESH_TOKEN_SECRET",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "refresh-token-secret-snapshot-test",
                      "version": "latest"
                    }
                  }
                }
              ],
              "ports": {
                "containerPort": 3000
              },
              "volumeMounts": [
                {
                  "mountPath": "/cloudsql",
                  "name": "cloudsql"
                }
              ]
            }
          ],
          "timeout": "3600s",
          "volumes": [
            {
              "cloudSqlInstance": {
                "instances": [
                  null
                ]
              },
              "name": "cloudsql"
            }
          ]
        },
        "traffics": [
          {
            "percent": 100,
            "type": "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST"
          }
        ]
      }
    },
    {
      "type": "gcp:cloudrunv2/service:Service",
      "name": "frontend",
      "inputs": {
        "deletionProtection": false,
        "ingress": "INGRESS_TRAFFIC_ALL",
        "invokerIamDisabled": true,
        "labels": {
          "git-dirty": "false",
          "git-sha": "snapshot-test-sha"
        },
        "location": "europe-west2",
        "name": "voneo-frontend-snapshot-test",
        "scaling": {
          "maxInstanceCount": 1,
          "minInstanceCount": 0
        },
        "template": {
          "containers": [
            {
              "envs": [
                {
                  "name": "API_PROXY_TARGET",
                  "value": "https://backend.run.app"
                },
                {
                  "name": "API_PROXY_ID_TOKEN",
                  "value": "true"
                }
              ]
            }
          ],
          "timeout": "3600s"
        },
        "traffics": [
          {
            "percent": 100,
            "type": "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST"
          }
        ]
      }
    },
    {
      "type": "gcp:cloudrunv2/serviceIamMember:ServiceIamMember",
      "name": "backend-invoker",
      "inputs": {
        "location": "europe-west2",
        "member": "serviceAccount:undefined",
        "name": "voneo-backend-snapshot-test",
        "role": "roles/run.invoker"
      }
    },
    {
      "type": "gcp:compute/network:Network",
      "name": "vpc",
      "inputs": {
        "autoCreateSubnetworks": false,
        "name": "voneo-snapshot-test"
      }
    },
    {
      "type": "gcp:compute/subnetwork:Subnetwork",
      "name": "vpc-subnet",
      "inputs": {
        "ipCidrRange": "10.10.0.0/24",
        "name": "voneo-snapshot-test",
        "network": "vpc_id",
        "region": "europe-west2"
      }
    },
    {
      "type": "gcp:projects/iAMMember:IAMMember",
      "name": "backend-cloudsql-client",
      "inputs": {
        "member": "serviceAccount:undefined",
        "project": "snapshot-test-project",
        "role": "roles/cloudsql.client"
      }
    },
    {
      "type": "gcp:projects/service:Service",
      "name": "artifactregistry-api",
      "inputs": {
        "disableOnDestroy": false,
        "service": "artifactregistry.googleapis.com"
      }
    },
    {
      "type": "gcp:projects/service:Service",
      "name": "compute-api",
      "inputs": {
        "disableOnDestroy": false,
        "service": "compute.googleapis.com"
      }
    },
    {
      "type": "gcp:projects/service:Service",
      "name": "iam-api",
      "inputs": {
        "disableOnDestroy": false,
        "service": "iam.googleapis.com"
      }
    },
    {
      "type": "gcp:projects/service:Service",
      "name": "run-api",
      "inputs": {
        "disableOnDestroy": false,
        "service": "run.googleapis.com"
      }
    },
    {
      "type": "gcp:projects/service:Service",
      "name": "secretmanager-api",
      "inputs": {
        "disableOnDestroy": false,
        "service": "secretmanager.googleapis.com"
      }
    },
    {
      "type": "gcp:projects/service:Service",
      "name": "sqladmin-api",
      "inputs": {
        "disableOnDestroy": false,
        "service": "sqladmin.googleapis.com"
      }
    },
    {
      "type": "gcp:secretmanager/secret:Secret",
      "name": "db-password-secret",
      "inputs": {
        "replication": {
          "auto": {}
        },
        "secretId": "db-password-snapshot-test"
      }
    },
    {
      "type": "gcp:secretmanager/secret:Secret",
      "name": "jwt-secret",
      "inputs": {
        "replication": {
          "auto": {}
        },
        "secretId": "jwt-secret-snapshot-test"
      }
    },
    {
      "type": "gcp:secretmanager/secret:Secret",
      "name": "refresh-token-secret",
      "inputs": {
        "replication": {
          "auto": {}
        },
        "secretId": "refresh-token-secret-snapshot-test"
      }
    },
    {
      "type": "gcp:secretmanager/secretIamMember:SecretIamMember",
      "name": "db-password-secret-access",
      "inputs": {
        "member": "serviceAccount:undefined",
        "role": "roles/secretmanager.secretAccessor",
        "secretId": "db-password-secret_id"
      }
    },
    {
      "type": "gcp:secretmanager/secretIamMember:SecretIamMember",
      "name": "jwt-secret-access",
      "inputs": {
        "member": "serviceAccount:undefined",
        "role": "roles/secretmanager.secretAccessor",
        "secretId": "jwt-secret_id"
      }
    },
    {
      "type": "gcp:secretmanager/secretIamMember:SecretIamMember",
      "name": "refresh-token-secret-access",
      "inputs": {
        "member": "serviceAccount:undefined",
        "role": "roles/secretmanager.secretAccessor",
        "secretId": "refresh-token-secret_id"
      }
    },
    {
      "type": "gcp:secretmanager/secretVersion:SecretVersion",
      "name": "db-password-version",
      "inputs": {
        "secretData": {
          "4dabf18193072939515e22adb298388d": "1b47061264138c4ac30d75fd1eb44270",
          "value": "snapshot-test-password"
        }
      }
    },
    {
      "type": "gcp:secretmanager/secretVersion:SecretVersion",
      "name": "jwt-secret-version",
      "inputs": {
        "secretData": {
          "4dabf18193072939515e22adb298388d": "1b47061264138c4ac30d75fd1eb44270",
          "value": "snapshot-test-jwt-secret"
        }
      }
    },
    {
      "type": "gcp:secretmanager/secretVersion:SecretVersion",
      "name": "refresh-token-secret-version",
      "inputs": {
        "secretData": {
          "4dabf18193072939515e22adb298388d": "1b47061264138c4ac30d75fd1eb44270",
          "value": "snapshot-test-refresh-secret"
        }
      }
    },
    {
      "type": "gcp:serviceaccount/account:Account",
      "name": "backend-sa",
      "inputs": {
        "accountId": "voneo-backend-snapshot-test",
        "displayName": "Voneo signalling API (snapshot-test)"
      }
    },
    {
      "type": "gcp:serviceaccount/account:Account",
      "name": "frontend-sa",
      "inputs": {
        "accountId": "voneo-frontend-snapshot-test",
        "displayName": "Voneo frontend (snapshot-test)"
      }
    },
    {
      "type": "gcp:sql/database:Database",
      "name": "db",
      "inputs": {
        "name": "voneo"
      }
    },
    {
      "type": "gcp:sql/databaseInstance:DatabaseInstance",
      "name": "voneo-db-snapshot-test",
      "inputs": {
        "databaseVersion": "MYSQL_8_4",
        "deletionProtection": false,
        "region": "europe-west2",
        "settings": {
          "availabilityType": "ZONAL",
          "edition": "ENTERPRISE",
          "ipConfiguration": {
            "ipv4Enabled": true,
            "sslMode": "ENCRYPTED_ONLY"
          },
          "tier": "db-f1-micro",
          "userLabels": {
            "git-dirty": "false",
            "git-sha": "snapshot-test-sha"
          }
        }
      }
    },
    {
      "type": "gcp:sql/user:User",
      "name": "db-user",
      "inputs": {
        "name": "voneo",
        "password": {
          "4dabf18193072939515e22adb298388d": "1b47061264138c4ac30d75fd1eb44270",
          "value": "snapshot-test-password"
        }
      }
    }
  ]
}
