        "network": "default",
        "platforms": [
          "linux/amd64"
        ],
        "push": true,
        "registries": [
          {
            "address": "europe-west2-docker.pkg.dev",
            "username": "oauth2accesstoken"
          }
        ],
        "tags": [
          "europe-west2-docker.pkg.dev/snapshot-test-project/voneo-snapshot-test/voneo-backend:snapshot-test"
        ]
      }
    },
    {
      "type": "docker-build:index:Image",
      "name": "frontend-image",
      "inputs": {
        "buildOnPreview": true,
        "context": {
          "location": "../web-server/src",
          "named": {
            "root": {
              "location": ".root-context"
            }
          }
        },
        "dockerfile": {
          "location": "../web-server/src/Dockerfile.prod"
        },
        "exec": true,
        "network": "default",
        "platforms": [
          "linux/amd64"
        ],
        "push": true,
        "registries": [
          {
            "address": "europe-west2-docker.pkg.dev",
            "username": "oauth2accesstoken"
          }
        ],
        "tags": [
          "europe-west2-docker.pkg.dev/snapshot-test-project/voneo-snapshot-test/voneo-frontend:snapshot-test"
        ]
      }
    },
    {
      "type": "gcp:artifactregistry/repository:Repository",
