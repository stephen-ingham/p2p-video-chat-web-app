    {
      "type": "gcp:cloudrunv2/service:Service",
      "name": "backend",
      "inputs": {
        "deletionProtection": false,
        "ingress": "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER",
        "invokerIamDisabled": true,
        "labels": {
          "git-dirty": "false",
          "git-sha": "snapshot-test-sha"
        },
        "location": "europe-west2",
        "name": "voneo-backend-snapshot-test",
        "scaling": {
          "maxInstanceCount": 1,
          "minInstanceCount": 0
        },
        "template": {
          "containers": [
            {
              "envs": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "ALLOWED_ORIGIN",
                  "value": "https://dev.voneo.test"
                },
                {
                  "name": "DB_NAME",
                  "value": "voneo"
                },
                {
                  "name": "DB_USER",
                  "value": "voneo"
                },
                {
                  "name": "DB_HOST",
                  "value": "/cloudsql/undefined"
                },
                {
                  "name": "DB_PASSWORD",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "db-password-snapshot-test",
                      "version": "latest"
                    }
                  }
                },
                {
                  "name": "JWT_SECRET",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "jwt-secret-snapshot-test",
                      "version": "latest"
                    }
                  }
                },
                {
                  "name": "REFRESH_TOKEN_SECRET",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "refresh-token-secret-snapshot-test",
                      "version": "latest"
                    }
                  }
                }
              ],
              "ports": {
                "containerPort": 3000
              },
              "volumeMounts": [
                {
                  "mountPath": "/cloudsql",
                  "name": "cloudsql"
                }
              ]
            }
          ],
          "timeout": "3600s",
          "volumes": [
            {
              "cloudSqlInstance": {
                "instances": [
                  null
                ]
              },
              "name": "cloudsql"
            }
          ]
        },
        "traffics": [
          {
            "percent": 100,
            "type": "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST"
          }
        ]
      }
    },
    {
      "type": "gcp:cloudrunv2/service:Service",
