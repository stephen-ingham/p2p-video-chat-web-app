{
  "name": "voneo-video-chat-app",
  "version": "1.0.0",
  "description": "P2P Video Chat App (Web & Android) built with Express.js, WebSockets & WebRTC",
  "scripts": {
    "setup": "node scripts/dispatch.mjs setup",
    "setup:nuke": "node scripts/dispatch.mjs nuke",
    "dev": "node scripts/dispatch.mjs dev",
    "dev:halt": "node scripts/dispatch.mjs halt-dev",
    "dev:tunnel": "ngrok start --all --config ngrok.yml",
    "lint": "xo --prettier --ignore \"mobile-app/**\"",
    "lint:fix": "xo --prettier --fix --ignore \"mobile-app/**\"",
    "test:e2e": "node scripts/dispatch.mjs test-e2e",
    "test:e2e:happy-path": "node scripts/dispatch.mjs test-e2e --grep @happy-path",
    "test:e2e:nat": "node scripts/dispatch.mjs test-e2e-nat",
    "prepare": "husky install"
  },
  "author": "cyprste2717218",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^10.0.3",
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "mysql2": "^3.24.4",
    "prettier": "^3.8.3",
    "xo": "^2.0.2"
  },
  "lint-staged": {
    "*.{ts,js,css}": "xo --prettier --fix"
  }
}
