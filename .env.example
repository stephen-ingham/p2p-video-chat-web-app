JWT_SECRET=thesecret
REFRESH_TOKEN_SECRET=anothersecret
NODE_ENV=dev
DB_NAME=dev-db
DB_PASSWORD=testpassword123
DB_HOST=mysql-db
DB_PORT=3306
NGROK_HOST=wss://<tunnel>.ngrok-free.dev
LOCAL=false #has to be false when WS_HOST is using ngrok and not localhost
ALLOWED_ORIGIN= #only consulted when NODE_ENV=production; the deployed frontend origin (CORS + WS upgrade allowlist), e.g. https://app.example.com
TURN_URLS= #optional; comma-separated self-hosted coturn URLs, e.g. stun:<ip>:3478,turn:<ip>:3478?transport=udp,turn:<ip>:3478?transport=tcp. Leave empty to use Google's public STUN servers (same-network testing only)
TURN_SECRET= #optional; coturn static-auth-secret used to mint short-lived TURN credentials. Must be set together with TURN_URLS
EAS_SKIP_AUTO_FINGERPRINT=1